#!/usr/bin/env bash

# Target directory defaults to current directory if not specified
TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist." >&2
    exit 1
fi

echo "Cleaning Python cache files and directories in: $TARGET_DIR"

# Recursively find and remove __pycache__ directories
find "$TARGET_DIR" -type d -name "__pycache__" -exec rm -rf {} +

# Recursively find and remove standalone .pyc and .pyo compiled files
find "$TARGET_DIR" -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete

echo "Cleanup complete."
